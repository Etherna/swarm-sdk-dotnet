<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Etherna.SwarmSdk.Wasm</RootNamespace>

    <Authors>Etherna SA</Authors>
    <Description>Utility services to work with Ethereum Swarm with WASM</Description>

    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The SDK formats and compares with the invariant culture or ordinally: without the ICU data the published
         host weighs about half. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A publish compiles ahead of time: hashing runs 3-4 times faster than on the interpreter, for a host about
         twice as heavy. It needs the wasm-tools workload, which a build doesn't: the condition keeps it off the
         build and the tests of the solution. The WebAssembly SDK compiles in a nested publish, which clears
         _IsPublishing and sets WasmBuildingForNestedPublish. -->
    <RunAOTCompilation Condition="'$(_IsPublishing)' == 'true' or '$(WasmBuildingForNestedPublish)' == 'true'">true</RunAOTCompilation>

    <RepositoryUrl>https://github.com/Etherna/swarm-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\COPYING" Pack="true" PackagePath="\" />
    <None Include="..\..\COPYING.LESSER" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwarmSdk.Client\SwarmSdk.Client.csproj" />
    <ProjectReference Include="..\SwarmSdk\SwarmSdk.csproj" />
  </ItemGroup>
</Project>
